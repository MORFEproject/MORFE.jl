#!/usr/bin/env bash
# Regenerates website/api.html before every push.
# If the result differs from what is committed, auto-commits the update
# so the push always carries a current API reference.
#
# Skip for a single push (e.g. when only pushing to a branch where CI handles it):
#   git push --no-verify
set -euo pipefail

echo "==> Regenerating website/api.html ..."
julia --project website/generate_api.jl

if ! git diff --quiet website/api.html; then
    echo "==> Committing updated website/api.html ..."
    git add website/api.html
    git commit -m "Regenerate API reference"
fi
