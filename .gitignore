# The formatter environment is pinned on purpose, so that everyone and CI
# produce byte-identical formatting.
!format/Manifest.toml

# Package artifacts (stores downloaded dependencies)
/artifacts/

# Generated documentation
docs/build/
docs/site/
website/documentation.html
website/*.zip

