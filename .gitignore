# Julia compiled code
*.jl.cov
*.jl.*.cov
*.jl.mem
*.o
*.so
*.dylib
*.dll
*.exe
Manifest.toml
docs/Manifest.toml
# The formatter environment is pinned on purpose, so that everyone and CI
# produce byte-identical formatting.  It lives beside the workflow that runs it.
!.github/format/Manifest.toml

# Package artifacts (stores downloaded dependencies)
/artifacts/

# Generated documentation
docs/build/
docs/site/
website/documentation.html
website/*.zip

# Temporary files from editors and OS
.DS_Store
*/.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
*.tmp

# Julia's package manager local logs
/LocalPreferences.toml

# (Optional) If you use Jupyter notebooks or other notebooks
*.ipynb_checkpoints/

# (Optional) If you use coverage tools like Codecov
/coverage/

.claude
CLAUDE.md

# Knowledge graph: regenerated machine state (AST cache, dated snapshots, HTML).
# Rebuild with `graphify update .`; it is never worth carrying in the repository.
graphify-out/

# Scratch notes, plans and analyses: the home for anything written for a
# developer rather than a user, so it never reaches the index by accident.
notes/

# Examples kept out of the package repository: they carry their own Project/Manifest,
# meshes and result archives, and are developed independently of the library.
examples/02_clamped_beam_gridap/
examples/06_dielectric_elastomer_actuator/

# Developer-only documents. Named individually rather than by a blanket *.md,
# which would swallow README.md and the example documentation that users read.
REFACTOR_HANDOFF.md
next_steps.md
plan_conjugate.md
profile_analysis.md
analytic_performance_analysis.md
multi_threaded_solve_analysis.md
test/SpectralDecomposition/EigensolverTestsFrancesco/statement.md
/publications
/legacy_morfe
# Generated example/benchmark outputs — ignore contents but allow results/reference/
# Use **/ so the rule applies at every depth, not just the repo root
benchmark_results*/
# Mesh files regenerated by generate_beam_mesh(es).jl — binary, not version-controlled
benchmark/ferrite/*.msh
examples/internals/eigensolver/.plotenv/
# Vendored MORFE 2.0 source (kept in archive repo only)
benchmark/morfe20/Morfe_2_0/
examples/mesh_import/Abaqus/output/
examples/mesh_import/Comsol/output/
*.h5
profile*.html
__pycache__/
*.pyc
W.jls
R.jls
*.vtu

# Timing measurement scratch files
timing_*.txt

# Never track IFX content, even if the folder reappears anywhere in the repo
IFX/
private/

# Tutorial pages retired from the website — kept locally for reference, not published
website_archive/
